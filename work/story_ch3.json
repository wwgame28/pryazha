   ],
   "outcomes": [
    {
     "if": {
      "orphans_jars": "returned"
     },
     "text": "Склянки не стали ничьей добычей. Ты оставил для детей имена, даты и дорогу обратно — если они когда-нибудь захотят идти.",
     "rewards": {
      "xp": 45
     },
     "worldEffects": [
      "deed:d_c3_returned_jars",
      "card+:quest:q_c3_orphans:1"
     ]
    },
    {
     "if": {
      "orphans_jars": "hidden"
     },
     "text": "Ты спрятал полку от описи. Это не свобода, но и не продажа. Хрусталина заметила пустое место в журнале.",
     "rewards": {
      "xp": 35,
      "echoes": 5
     },
     "worldEffects": [
      "card+:quest:q_c3_orphans:1"
     ]
    },
    {
     "if": {},
     "text": "Ты ушёл, ничего не решив. Склянки остались ровно стоять в синем свете.",
     "rewards": {
      "xp": 20
     },
     "worldEffects": [
      "card+:quest:q_c3_orphans:1"
     ]
    }
   ]
  }
