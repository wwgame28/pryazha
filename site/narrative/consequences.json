 "facts": {
  "f_thread_wrist": {
   "title": "Нитка на запястье",
   "text": "Серая шерстяная нитка, ткачья вязка. Не развязывается и не рвётся. Агафья сказала: «не моя вязка»."
  },
  "f_two_knots": {
   "title": "Два узелка в косе Агафьи",
   "text": "Красный, свежий — про Митю. Под ним серый, старый. «Это не твоё»."
  },
  "f_ashes_phrase": {
   "title": "«Всегда пустой был»",
   "text": "Про пепелище у брода все говорят одними и теми же словами. Будто выучили."
  },
  "f_ashes_doll": {
   "title": "Обгоревшая берестяная кукла",
   "text": "В крапиве на пепелище. Детская. Кто-то делал её для девочки."
  },
  "f_ashes_ladle": {
   "title": "Оплавленный черпак с буквой «М»",
   "text": "Медный, для отваров. Буква выбита неровно, своей рукой."
  },
  "f_ashes_scrap": {
   "title": "Клочок бересты: «держит»",
   "text": "Обгорелый край списка. Угольное слово «держит» и половина чьей-то буквы."
  },
  "f_efim_name": {
   "title": "Имя утопленника",
   "text": "Утопленник у брода — Ефим, брат Федота. Отпущен прошлой весной."
  },
  "f_crypt_tight": {
   "title": "«Тесно»",
   "text": "Мёртвые у брода говорят одно слово: «тесно». Под кладбищем им не хватает места."
  },
  "f_red_winter_gurdym": {
   "title": "Красная зима Гурдыма",
   "text": "Тролль помнит зиму, когда река у брода стала красной: люди в огне и мальчик с факелом."
  },
  "f_shirts_m": {
   "title": "Буква «М» на рубашках",
   "text": "Пелагея каждую зиму шьёт рубашки на мальчика лет семи. На каждом вороте вышита «М»."
  },
  "f_agafya_knots": {
   "title": "Агафья вяжет узелки",
   "text": "Агафья умеет уводить мёртвых узелком. По обычаю Брода это грех."
  },
  "f_well_voices": {
   "title": "Голоса в колодце",
   "text": "На дне колодца кто-то смеётся: «Воды, Марфушка, воды!»"
  }
 },
