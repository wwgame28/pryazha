 "chapters": {
  "1": {
   "title": "Из воды",
   "epigraph": "Река у Ольхового Брода много чего приносит. Обычно обратно.",
   "where": "Ольховый Брод. Осень, первые заморозки."
  },
  "2": {
   "title": "Проводы",
   "epigraph": "Раз в год деревня в последний раз говорит имена вслух. Потом их не говорят никогда.",
   "where": "Лес, Гурдымов Камень, брод в ночь Проводов."
  },
  "3": {
   "title": "Печать изнутри",
   "epigraph": "Тебе соврут трижды. Сложи враньё — получится правда.",
   "where": "Склеп под Старым кладбищем. Башня, Стан, Руины."
  },
  "4": {
   "title": "Белая кромка",
   "epigraph": "Деревня есть, а дороги к ней будто никогда не было.",
   "where": "Степь, Сухой Лог, Выцветь."
  },
  "5": {
   "title": "Красная зима",
   "epigraph": "Мир стоит на том, что больно отпустить. А на том, что стыдно вспомнить?",
   "where": "Ольховый Брод. Тридцать пять лет спустя."
  },
  "6": {
   "title": "Ночь Перевязки",
   "epigraph": "Девятьсот сорок три имени. И одно — твоё, если ты его выбрал.",
   "where": "Тихая Сторона. Нижний зал."
  }
 },
